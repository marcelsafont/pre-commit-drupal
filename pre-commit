#!/usr/bin/env bash

# Patterns to block
PATTERNS="console\.log\(|dd\(|dpm\("

# Check staged changes only
if git diff --cached | grep -E -n "$PATTERNS"; then
  echo ""
  echo "❌ Commit blocked: debug statements found in staged changes."
  echo "   Please remove console.log / dd / dpm calls before committing."
  echo ""
  exit 1
fi

exit 0

